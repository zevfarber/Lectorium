{
 "lines": [
  {
   "cite": "1.1a",
   "deva": "धर्मक्षेत्रे कुरुक्षेत्रे समवेता युयुत्सवः ।",
   "iast": "dharmakṣetre kurukṣetre samavetā yuyutsavaḥ "
  },
  {
   "cite": "1.1b",
   "deva": "मामकाः पाण्डवाश्चैव किमकुर्वत संजय ॥",
   "iast": "māmakāḥ pāṇḍavāścaiva kimakurvata saṃjaya "
  },
  {
   "cite": "2.22a",
   "deva": "वासांसि जीर्णानि यथा विहाय नवानि गृह्णाति नरोऽपराणि ।",
   "iast": "vāsāṃsi jīrṇāni yathā vihāya navāni gṛhṇāti naroparāṇi "
  },
  {
   "cite": "2.22b",
   "deva": "तथा शरीराणि विहाय जीर्णान्यन्यानि संयाति नवानि देही ॥",
   "iast": "tathā śarīrāṇi vihāya jīrṇānyanyāni saṃyāti navāni dehī "
  },
  {
   "cite": "2.47a",
   "deva": "कर्मण्येवाधिकारस्ते मा फलेषु कदाचन ।",
   "iast": "karmaṇyevādhikāraste mā phaleṣu kadācana "
  },
  {
   "cite": "2.47b",
   "deva": "मा कर्मफलहेतुर्भूर्मा ते सङ्गोऽस्त्वकर्मणि ॥",
   "iast": "mā karmaphalaheturbhūrmā te saṅgostvakarmaṇi "
  }
 ]
}